<?xml version="1.0" encoding="utf-8"?>
<!--
    An ADAPTIVE icon, not a bare glyph, which is the whole fix: a launcher
    given a plain drawable for a shortcut treats it as a legacy icon and
    draws its own white circle behind it — so the white-on-dark half of
    @color/ic_launcher_ink came out white on white, i.e. an empty disc. An
    adaptive icon brings its own background layer and is masked rather than
    padded, so both halves keep their contrast and the shortcuts match the
    launcher icon they hang off.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg" />
    <foreground android:drawable="@drawable/ic_shortcut_new_tab_foreground" />
</adaptive-icon>
