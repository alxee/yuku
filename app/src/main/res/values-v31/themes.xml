    </style>

    <!--
        98 takes the accent's place instead of taking the accent, so it keeps
        one splash of its own — ground and ink both.
    -->
    <style name="SplashTheme.Ninety8" parent="Theme.Browser.Splash">
        <item name="splashInk">@color/splash_ink_98</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg_98</item>
    </style>
</resources>
